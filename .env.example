# Copie para .env e preencha

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://sofia:sofia@127.0.0.1:5433/sofia
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
POSTGRES_USER=sofia
POSTGRES_PASSWORD=sofia_change_me
POSTGRES_DB=sofia
POSTGRES_PORT=5433
SOFIA_API_PORT=8001
SOFIA_DASH_PORT=5180

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

DEFAULT_CLIENT_ID=teste-local

# ── Cobertura ──────────────────────────────────────
# mock = testes locais | ixc = Google Maps + IXC real
COVERAGE_PROVIDER=mock

GOOGLE_MAPS_API_KEY=
IXC_BASE_URL=https://ixc.mov.pro.br/webservice/v1
IXC_USER=
IXC_PASSWORD=
# Defaults cadastro cliente (MOV FIBRA)
IXC_FILIAL_ID=3
IXC_ID_TIPO_CLIENTE=19
IXC_TIPO_ASSINANTE=3
IXC_ISS_CLASSIFICACAO=99
IXC_CONTRIBUINTE_ICMS=I
IXC_TIPO_LOCALIDADE=U
IXC_ID_CONTA=70302
IXC_ID_CANDIDATO_TIPO=45
IXC_UF=20
IXC_CIDADE_ID=209
IXC_SENHA_HOTSITE=movbrasil

# ── CPF / IXC ──────────────────────────────────────
# mock = sempre CPF novo | ixc = consulta real no IXC
CPF_PROVIDER=mock
# mock = simula cadastro | webhook = n8n (cliente + contrato + OS) | ixc = API direta (só cliente)
CADASTRO_PROVIDER=webhook
CADASTRO_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/cadastrar_cliente_sofia
CADASTRO_WEBHOOK_TOKEN=
CADASTRO_TIMEOUT_SECONDS=90

# Agenda — horários de técnicos (n8n subfluxo via webhook)
AGENDA_PROVIDER=mock
AGENDA_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/verifica_tecnicos
AGENDA_INSERIR_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/insere_agenda
AGENDA_WEBHOOK_TOKEN=
AGENDA_TIMEOUT_SECONDS=25

# Encerramento — PDF no IXC + resolve Chatwoot (n8n)
ENCERRAR_PROVIDER=mock
ENCERRAR_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/encerrar_atendimento
ENCERRAR_WEBHOOK_TOKEN=
ENCERRAR_TIMEOUT_SECONDS=90

# Termos — áudio fidelidade + PDF contrato (n8n → Chatwoot)
TERMOS_PROVIDER=webhook
TERMOS_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/enviar_termos_sofia
TERMOS_WEBHOOK_TOKEN=
TERMOS_TIMEOUT_SECONDS=60

# Ativação — cliente_contrato_ativar_cliente (n8n → IXC)
ATIVACAO_PROVIDER=webhook
ATIVACAO_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/ativar_cliente_sofia
ATIVACAO_WEBHOOK_TOKEN=
ATIVACAO_TIMEOUT_SECONDS=45

# Imagem do plano — Chatwoot (n8n; cole base64 nos Sets do subfluxo)
IMAGEM_PLANO_PROVIDER=webhook
IMAGEM_PLANO_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/enviar_imagem_plano_sofia
IMAGEM_PLANO_WEBHOOK_TOKEN=
IMAGEM_PLANO_TIMEOUT_SECONDS=45
# URL pública da API para o n8n baixar /media/planos/...
PUBLIC_BASE_URL=http://127.0.0.1:8001

# ── RAG (objeções / FAQ) ───────────────────────────
# mock = FAQ local (dev/teste) | webhook = n8n ou serviço externo | none = desligado
RAG_PROVIDER=mock
RAG_WEBHOOK_URL=
RAG_WEBHOOK_TOKEN=
RAG_TIMEOUT_SECONDS=12

# ── Planos ─────────────────────────────────────────
# sqlite = seed local | webhook = n8n / Postgres (fallback SQLite se webhook falhar)
# Planos: postgres | webhook
PLANS_PROVIDER=postgres
PLANS_WEBHOOK_URL=
PLANS_WEBHOOK_TOKEN=
PLANS_TIMEOUT_SECONDS=15
PLANS_CACHE_TTL_SECONDS=300
PLANS_PLANO_INICIAL=MOV SUPER

# Debounce de mensagens no /chat (UI local)
MESSAGE_BUFFER_ENABLED=true
MESSAGE_BUFFER_SECONDS=2.5
# Webhook Chatwoot: false = processa na hora (n8n já pode agrupar; evita debounce duplo)
CHATWOOT_BUFFER_ENABLED=false

# ── Chatwoot / Meta (caixa MOV IA) ─────────────────
CHATWOOT_BASE_URL=https://chatwoot.mov.pro.br
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=2
CHATWOOT_INBOX_ID=6
# true = Eva posta outgoing direto na API Chatwoot
CHATWOOT_REPLY_ENABLED=false
# Webhook n8n — envia resposta da Eva ao cliente (recomendado com mov_woot)
CHATWOOT_MSG_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/envia_mensagem_eva
CHATWOOT_MSG_WEBHOOK_TOKEN=
CHATWOOT_MSG_WEBHOOK_TIMEOUT_SECONDS=30

# Handoff automático quando a Sofia TRANSFERIR_HUMANO
CHATWOOT_TRANSFER_ENABLED=false
CHATWOOT_TRANSFER_TEAM_ID=
CHATWOOT_TRANSFER_ASSIGNEE_ID=
CHATWOOT_TRANSFER_LABELS=sofia_transferido
CHATWOOT_TRANSFER_STATUS=open

# CORS do dashboard (Vite)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Entrada: closed | allowlist | open
SOFIA_INBOUND_MODE=allowlist
SOFIA_ALLOWLIST_PHONES=93992219098
SOFIA_ENFORCE_ALLOWLIST_ON_CHAT=false

ADMIN_API_TOKEN=

# Alertas: none | evolution | chatwoot | both
ALERT_PROVIDER=evolution
ALERT_PHONES=
ALERT_MESSAGE_TEMPLATE=Sofia alerta: {contexto} — {detalhe}
ALERT_CHATWOOT_CONVERSATION_ID=
ALERT_CHATWOOT_PRIVATE=true

EVOLUTION_API_URL=https://evolutiongo.xmov.com.br
EVOLUTION_API_KEY=
EVOLUTION_ALERT_NUMBER=
