# ── Eva MOV FIBRA — variáveis para stack Portainer ──
# Copie para .env na raiz do projeto ou cole no editor "Environment" do Portainer.
# NÃO commite o .env real (contém segredos).

# ── Portas HOST (altere se houver conflito no servidor) ──
SOFIA_API_PORT=8001
SOFIA_DASH_PORT=5180
POSTGRES_PORT=5433

# ── PostgreSQL ──
POSTGRES_USER=sofia
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=sofia
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20

# ── URL pública da API (sem domínio: http://IP:8001) ──
PUBLIC_BASE_URL=http://SEU-IP-PUBLICO:8001
CORS_ORIGINS=http://SEU-IP-PUBLICO:5180

# ── OpenAI ──
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── Painel admin ──
ADMIN_API_TOKEN=token-forte-para-o-painel

# ── Entrada Chatwoot ──
SOFIA_INBOUND_MODE=allowlist
SOFIA_ALLOWLIST_PHONES=93992219098
CHATWOOT_BASE_URL=https://chatwoot.mov.pro.br
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=2
CHATWOOT_INBOX_ID=6
CHATWOOT_REPLY_ENABLED=false
CHATWOOT_MSG_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/envia_mensagem_eva

# ── Integrações n8n (ajuste URLs) ──
COVERAGE_PROVIDER=ixc
CADASTRO_PROVIDER=webhook
CADASTRO_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/cadastrar_cliente_sofia
TERMOS_PROVIDER=webhook
TERMOS_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/enviar_termos_sofia
ATIVACAO_PROVIDER=webhook
ATIVACAO_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/ativar_cliente_sofia
AGENDA_PROVIDER=webhook
AGENDA_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/verifica_tecnicos
AGENDA_INSERIR_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/insere_agenda
IMAGEM_PLANO_PROVIDER=webhook
IMAGEM_PLANO_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/enviar_imagem_plano_sofia
RAG_PROVIDER=webhook
RAG_WEBHOOK_URL=https://n8n2.mov.pro.br/webhook/RAG_VENDAS

# ── IXC / Google Maps ──
GOOGLE_MAPS_API_KEY=
IXC_USER=
IXC_PASSWORD=

# ── Docker Hub (só se usar docker-compose.hub.yml) ──
# DOCKERHUB_USER=seu_usuario
# IMAGE_TAG=latest
